# Proveïdor LLM
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=POSA_AQUI_LA_TEVA_CLAU
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_APP_NAME=TFG-Uyuni-MCP

# Opcional: Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# MCP Uyuni
MCP_UYUNI_ENABLED=true
MCP_UYUNI_COMMAND=docker
MCP_UYUNI_ARGS=run,-i,--rm,--env-file,RUTA_AL_ENV_DE_UYUNI,ghcr.io/uyuni-project/mcp-server-uyuni:latest
MCP_UYUNI_TIMEOUT_SECONDS=120
